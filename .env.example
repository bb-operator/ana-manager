COMPOSE_PROJECT_NAME=ana-system-manager

# Local development
APP_PORT=8055
MANAGER_APP_PORT=8080

# Directus
DIRECTUS_KEY=replace-with-random-key
DIRECTUS_SECRET=replace-with-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
PUBLIC_URL=http://localhost:8055

# Postgres
POSTGRES_DB=ana_system_manager
POSTGRES_USER=ana_manager
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ana_manager:change-me@postgres:5432/ana_system_manager

# Optional: used later when Directus/n8n exchange config safely
N8N_SHARED_SECRET=replace-with-shared-secret

# Basic auth for the custom Ana System Manager UI
MANAGER_BASIC_USER=admin
MANAGER_BASIC_PASSWORD=change-me
